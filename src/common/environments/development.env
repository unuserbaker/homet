
# Application configuration
# Valid environments: 'development', 'production', 'testing', 'staging
# All sensitive information is stored in keyvualt secrets, so the environment variables will contain the name of the secret

APP_ENV=development
APP_NAME="Nestjs Project Structure Example"
APP_URL=http://localhost
APP_PORT=3000


# Data base configuration
# Use only secret name, don't put sensible data.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=testDb
DB_USER=tesDbUser
DB_PASSWORD=myPassword123

# DB_HOST=DATABASESERVER
# DB_PORT=1433
# DB_NAME=DATABASENAME
# DB_USER=DATABASEUSER
# DB_PASSWORD=DATABASEPASSWORD

#Cache In-Memory configuration
CACHE_IS_GLOBAL=true
CACHE_TTL=5000
CACHE_MAX_ITEM=500

#Rate limit (throttler)
RL_LIMIT=1000
RL_TTL=100
RL_BLOCKDURATION=100

